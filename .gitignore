.claude/settings.local.json
.claude/worktrees/
.DS_Store

# Angular / Node (angular/)
node_modules
dist/
.angular/
playwright-report/
test-results/

# Optional local friction measurements; never automatic telemetry.
.harness/friction.jsonl

.harness/friction-session.json
.harness/review-outcomes.json

# The complete test report the quiet reporter pairs with (tools/quiet-reporter.mjs).
.test-report.txt

# Local config: API keys (OpenRouteService and later providers). Never commit it.
public/config.local.json
.env
